{{.Import "context" "go.opentelemetry.io/otel" "go.opentelemetry.io/otel/codes"}}

{{ $decorator := (or .Vars.DecoratorName (printf "%sWithTracing" .Interface.Name)) }}
{{ $prefix := (or .Vars.Prefix .Interface.Name) }}

// {{$decorator}} instruments {{.Interface.Type}} with OpenTelemetry spans (one per
// ctx-carrying method) via the OTel global tracer. Non-ctx methods pass through
// untraced. It is generated same-package as the interface so it must NOT import
// internal/tracing (that package imports provider, which would form a cycle).
type {{$decorator}} struct {
	{{.Interface.Type}}
}

// New{{$decorator}} wraps base so every ctx-carrying call opens a span.
func New{{$decorator}}(base {{.Interface.Type}}) {{.Interface.Type}} {
	return &{{$decorator}}{ {{.Interface.Name}}: base }
}

// _{{$decorator}}Tracer is resolved ONCE from the OTel global (installed by
// internal/tracing.Setup) and reused per call, avoiding the two process-global
// tracer-provider lookup mutexes otel.Tracer(name) takes on every wrapped call —
// keeping the disabled (default) path cheap. Set at package-init, never reassigned.
var _{{$decorator}}Tracer = otel.Tracer("op-ai-gateway")

{{range $method := .Interface.Methods}}
func (_d *{{$decorator}}) {{$method.Declaration}} {
	{{- if $method.AcceptsContext }}
	ctx, span := _{{$decorator}}Tracer.Start(ctx, "{{$prefix}}.{{$method.Name}}")
	defer span.End()
	{{- if $method.ReturnsError }}
	defer func() {
		if err != nil {
			span.RecordError(err)
			span.SetStatus(codes.Error, err.Error())
		}
	}()
	{{- end }}
	{{- end }}
	{{ $method.Pass (printf "_d.%s." $.Interface.Name) }}
}
{{end}}
