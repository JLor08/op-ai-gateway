# Copy to .env and adjust. .env is gitignored.
#
# CONFIG FILE (alternative to env vars): the gateway also reads an optional JSON
# config file — OP_AI_GATEWAY_CONFIG=<path>, else `gateway.json` next to the
# binary. It uses the SAME keys as these env vars, e.g.
#   {"OP_AI_GATEWAY_ADDR": "0.0.0.0:8080", "OP_AI_GATEWAY_POSTGRES_DSN": "..."}
# Precedence: env var > config file > built-in default (an env var of the same
# name always wins). A malformed config file is a startup error. Because the file
# can hold the DB DSN / capture key, restrict its permissions (chmod 600).
OP_AI_GATEWAY_ADDR=0.0.0.0:8080
# The docker-compose test environment runs on PostgreSQL (the `db` service).
OP_AI_GATEWAY_DB_DRIVER=postgres
# Postgres credentials for the bundled `db` service. The backend's DSN is assembled
# automatically from these in docker-compose (see the backend service's environment).
# Change them ONLY here — no compose edit needed.
POSTGRES_USER=gateway
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gateway
# EXTERNAL database instead of the bundled `db`: set OP_AI_GATEWAY_POSTGRES_DSN directly
# and remove the backend service's `environment:` DSN override in docker-compose.
# OP_AI_GATEWAY_POSTGRES_DSN=postgres://user:pass@host:5432/db?sslmode=require
# For a simple local (non-compose) run, use sqlite instead of the two lines above:
#   OP_AI_GATEWAY_DB_DRIVER=sqlite
#   OP_AI_GATEWAY_SQLITE_PATH=/data/op-ai-gateway.db
# Schema migrations run automatically on startup (versioned, apply-only-pending),
# so deploying a newer image upgrades the database in place.
OP_AI_GATEWAY_AUTO_MIGRATE=true
OP_AI_GATEWAY_PUBLIC_URL=http://localhost:8080/portal
# Plain-HTTP test env: the session cookie must NOT be Secure or login breaks.
# Set to true only behind TLS-terminating ingress.
OP_AI_GATEWAY_SESSION_COOKIE_SECURE=false
# Streaming idle timeout: max inactivity between SSE tokens before a stalled
# upstream stream is aborted. Default 120s. Set to 0 to disable (unbounded;
# only client disconnect ends a stream). There is no total stream cap.
OP_AI_GATEWAY_STREAM_IDLE_TIMEOUT=120s
# Swap-protection recency window (seconds): a server actively serving a model within
# this window is not evicted by a request for a different model. Default 30.
OP_AI_GATEWAY_SWAP_PROTECT_WINDOW_SECONDS=30
# Retention window (hours) for per-server availability history (health + agent
# presence timeline/graphs). Default 720 = 30 days; set e.g. 2160 for 90 days.
OP_AI_GATEWAY_AVAILABILITY_RETENTION_HOURS=720
# Freshness window (seconds) for "ServerAgent reporting": the agent counts as
# reporting if it POSTed telemetry within this window. This is the ENV FALLBACK
# for the operator-settable agent_presence_timeout_seconds system setting (System
# Settings) -- the KV value is the live authority once set there. Default 15.
OP_AI_GATEWAY_AGENT_PRESENCE_TIMEOUT_SECONDS=15
# Seconds a sticky session holds a reserved concurrency slot on its server for the
# capacity cap (CP3). Default 60; a value <= 0 falls back to 60 (this knob only sets
# the window, it cannot disable reservation).
OP_AI_GATEWAY_SESSION_RESERVATION_WINDOW_SECONDS=60
# Max number of requests that may WAIT in the admission-control queue for a free
# concurrency slot (CP4). Once full, a new over-capacity request is rejected with 503
# immediately instead of piling up. Default 128.
OP_AI_GATEWAY_ADMISSION_QUEUE_MAX_DEPTH=128
# Default cadence (seconds) for the scheduled benchmark mode when an application
# enables it without setting its own interval. Default 86400 (once a day); floored
# at 60s per app regardless.
OP_AI_GATEWAY_BENCHMARK_SCHEDULE_DEFAULT_SECONDS=86400
# Capacity-benchmark tuning. VRAM safety margin (percent of total VRAM kept free:
# the concurrency ramp stops before crossing it so it never OOMs); max concurrency
# the ramp probes up to; settle time (seconds) between ramp steps. Defaults 10/64/5.
OP_AI_GATEWAY_CAPACITY_VRAM_SAFETY_MARGIN_PERCENT=10
OP_AI_GATEWAY_CAPACITY_MAX_CONCURRENCY=64
OP_AI_GATEWAY_CAPACITY_SETTLE_SECONDS=5
# Cadence (seconds) of the NetBird peer-sync loop (keeps the peer name = server name,
# the server domain = peer DNS name, and the connected status fresh). Default 60;
# a value <= 0 falls back to 60, and any value is floored at 30s.
OP_AI_GATEWAY_NETBIRD_SYNC_INTERVAL_SECONDS=60
# Auto-rotate the NetBird admin API token this many days before it expires
# (default 14; 0 disables). This is only the env-fallback default — the live
# authority is the operator-settable field in the NetBird settings UI once set.
OP_AI_GATEWAY_NETBIRD_TOKEN_ROTATE_BEFORE_DAYS=14
# NetBird-only transport (Phase 1). Explicit agent-listener bind host:port;
# overrides the selected gateway peer. Empty (default) = no dedicated agent
# listener from an explicit address (the agent route stays on the main listener).
OP_AI_GATEWAY_AGENT_ADDR=
# Port for the NetBird agent listener when bound via the selected gateway peer
# (netbird_gateway_peer_id → resolved peer IP). Default 8081.
OP_AI_GATEWAY_AGENT_PORT=8081
# Separate encrypted agent (mesh) port (see README-certificates.md §10.10). Boot
# default for cert_mesh_tls_mode: false = combined (one port sniffs plaintext+TLS,
# today's behavior), true = separate (the port above stays plaintext-only and a
# DEDICATED TLS-only listener comes up on the TLS port below). The portal setting
# cert_mesh_tls_mode ("" = follow this env, combined, separate) overrides it live.
OP_AI_GATEWAY_AGENT_TLS_SEPARATE=false
# Port of the dedicated TLS-only agent listener when bound via the selected gateway
# peer. Deploy-time only (the portal shows it read-only). Default 8443.
OP_AI_GATEWAY_AGENT_TLS_PORT=8443
# Explicit host:port for the dedicated TLS agent listener; overrides the peer-derived
# address. Empty (default) = <mesh-ip>:AGENT_TLS_PORT. Set 0.0.0.0:<port> AND add a
# compose `ports:` entry to host-publish it (guarded by the netbird_only source check).
OP_AI_GATEWAY_AGENT_TLS_ADDR=
# Cross-compile the downloadable server-agent binaries at deploy time. false =
# skip (fast; reuse the agent-bin volume's previous build). Set true when the
# agent changed: `docker compose build agent-builder && BUILD_AGENTS=true docker compose up -d`.
BUILD_AGENTS=false
# Directory the backend serves agent binaries from (matches the agent-bin mount).
# Empty disables the download feature.
OP_AI_GATEWAY_AGENT_BINARY_DIR=/agents
# --- NetBird sidecar (docker-compose `netbird` service; Phase 2) ---------------
# The gateway joins the mesh via a NetBird client sidecar so the agent listener can
# bind the gateway's own NetBird IP and gateway→app traffic routes over wt0. These
# vars configure that sidecar (NOT the gateway's admin-API module, which is set in
# System Settings). Enrollment: create a setup key + a group (e.g. op-gw-portal) in
# NetBird first. See README-netbird.md for the full runbook. The `netbird-client`
# volume MUST persist across restarts/updates so the peer keeps a stable identity/IP
# (never `docker compose down -v`).
# One-off or reusable setup key (used ONLY on first enrollment; ignored once the
# persisted volume holds an identity — idempotent to leave set):
NB_SETUP_KEY=
# Self-hosted NetBird management URL, e.g. https://netbird.example.com. Empty =
# the NetBird cloud (https://api.netbird.io). For the AUTONOMOUS self-enroll ("Sidecar
# enrollen") this is now OPTIONAL: the gateway drops the System-Settings NetBird URL
# next to the key file and the wrapper uses it; set this only to override:
NB_MANAGEMENT_URL=
# Peer name shown in NetBird + the System-Settings gateway-peer picker. Stable id:
NB_HOSTNAME=op-gateway
# --- Autonomous sidecar self-enroll (Phase B) ----------------------------------
# The gateway can MINT a NetBird setup key from System Settings ("Sidecar enrollen")
# and write it to a shared, TRANSIENT (tmpfs) volume; the custom netbird sidecar
# (built from Dockerfile.netbird) WAITS for that file and self-`netbird up`s — no
# operator copy-paste. Both vars must point at the SAME file on the shared /shared
# volume. Leave NB_SETUP_KEY (above) EMPTY to use this path; setting NB_SETUP_KEY
# directly DISABLES the autonomous path (the sidecar enrolls with the env key the old
# Phase-2/3 way). The manual "Gateway-Setup-Key erstellen" button (Phase A) still
# works regardless. See README-netbird.md §11.
# Backend: where the gateway WRITES the minted key (empty = the autonomous path is off):
OP_AI_GATEWAY_NETBIRD_KEY_FILE=/shared/netbird-setup-key
# Sidecar: where the entrypoint wrapper READS the key from (must match the line above).
# This is a WRAPPER-only var — do NOT use netbird's NB_SETUP_KEY_FILE here: netbird treats
# setup-key and setup-key-file as mutually exclusive and aborts if both are present, which
# (shared netns) would 502 the whole gateway. The wrapper hands netbird only NB_SETUP_KEY.
NB_ENROLL_KEY_FILE=/shared/netbird-setup-key
# Energy-attribution background reconciler (internal/gateway/energy_reconciler.go)
# + idle tracker (energy_idle.go). Cadence (seconds) of the reconciler pass that
# attributes energy to un-priced usage events; how long (seconds) it waits after a
# request finishes before pricing it (lets telemetry samples + concurrent sibling
# requests land first); and the trailing window (seconds) the per-server
# idle-wattage tracker holds a rolling minimum of observed power draw over, before
# letting the estimate rise again after a sustained load increase. Defaults
# 15 / 10 / 3600.
OP_AI_GATEWAY_ENERGY_RECONCILE_INTERVAL_SECONDS=15
OP_AI_GATEWAY_ENERGY_SETTLE_SECONDS=10
OP_AI_GATEWAY_ENERGY_IDLE_WINDOW_SECONDS=3600
OP_AI_GATEWAY_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
OP_AI_GATEWAY_BOOTSTRAP_ADMIN_NAME=Admin User
# Generate: openssl rand -hex 32
OP_AI_GATEWAY_BOOTSTRAP_API_TOKEN=change-me-openssl-rand-hex-32
# Agent token for the seeded default AI server (only used the first time the
# database is empty, to seed the built-in mock provider). Required on a
# non-loopback bind (0.0.0.0). Generate: openssl rand -hex 32
OP_AI_GATEWAY_DEV_AGENT_TOKEN=change-me-openssl-rand-hex-32
# Optional: seed a LOGIN-ABLE password for the bootstrap admin so automated /
# container deploys don't need the invite-link-in-logs flow. Empty = no password
# is set and the one-time set-password invite link is logged instead. Only applied
# on a fresh admin (never overwrites an already-set password).
OP_AI_GATEWAY_BOOTSTRAP_ADMIN_PASSWORD=
# Payload capture (SP-C + SP-C+): AES-256-GCM key for encrypting captured
# request/response bodies at rest. 32 bytes, hex-encoded. Empty = capture
# falls back to the volatile in-RAM store (see
# OP_AI_GATEWAY_CAPTURE_MEMORY_MAX_BYTES below) instead of persistent
# encrypted storage; capture is still gated on a token's log_communication
# flag and the capture_enabled system setting either way.
# Generate: openssl rand -hex 32
OP_AI_GATEWAY_CAPTURE_ENCRYPTION_KEY=
# Max bytes of a single captured request/response body before it is truncated.
# Default 1048576 (1 MiB).
OP_AI_GATEWAY_CAPTURE_MAX_BYTES=1048576
# Byte budget for the volatile in-RAM capture store (memory driver, or the
# SQLite driver with no OP_AI_GATEWAY_CAPTURE_ENCRYPTION_KEY set): oldest
# captures are evicted first once the sum of stored blob bytes exceeds this.
# Default 67108864 (64 MiB). Counts blob bytes only, not process RSS.
OP_AI_GATEWAY_CAPTURE_MEMORY_MAX_BYTES=67108864
# TEST-ONLY: artificial latency (in milliseconds) for the built-in mock provider,
# so a live e2e can observe an in-flight ("running connection") request. The mock
# waits this long (honoring request cancellation) before producing output.
# Default 0 = off (production-safe). Junk / 0 / negative -> 0.
OP_AI_GATEWAY_MOCK_DELAY_MS=0

# --- Tracing (opt-in OpenTelemetry) ---
# Master switch. false (default) = ~zero overhead (spans dropped by the sampler).
# Toggle live at runtime via PUT /api/system/tracing (system scope). Set the log
# level to `trace` (PUT /api/system/logs/level, or the portal Logs view) to see
# per-method spans in the portal Logs view.
OP_AI_GATEWAY_TRACING_ENABLED=false
# Fraction of traces sampled WHEN enabled (0..1). Default 1.0.
OP_AI_GATEWAY_TRACING_SAMPLE_RATIO=1.0
# Optional OTLP-HTTP collector endpoint (e.g. http://tempo:4318). Empty = no export.
OP_AI_GATEWAY_OTLP_ENDPOINT=
# In-memory log-ring capacity (always-on, viewer-independent). Default 5000.
OP_AI_GATEWAY_LOG_BUFFER_SIZE=5000

# Certificate module (ACME/Let's Encrypt). The module itself is switched on in the
# portal (System settings -> "Zertifikatsverwaltung aktiv"); this only tunes how
# often the gateway checks for due issuance/renewal. Default 900s, floor 60s.
OP_AI_GATEWAY_CERT_RECONCILE_INTERVAL_SECONDS=900
# AES-256-GCM key for the certificate module: EVERY private key it handles
# (leaf keys, the ACME account key, the internal CA key) is sealed with THIS key
# before being written. 32 bytes, hex-encoded. Generate: openssl rand -hex 32
#
# Either a REAL 64-character hex value or EMPTY (as shipped below) -- nothing in
# between. The cipher is built unconditionally at startup, so a placeholder or any
# other non-hex value is a fatal misconfiguration and the gateway refuses to start,
# even when the certificate module is never enabled. Empty is the safe default: the
# gateway starts, and the portal names this variable if the module is later switched on.
#
# This is a SEPARATE secret from OP_AI_GATEWAY_CAPTURE_ENCRYPTION_KEY above --
# certificate material is scoped and rotatable independently of payload
# capture. Do NOT reuse the same value for both: the gateway logs a startup WARN
# when the two variables carry the same value, because that makes the separation
# nominal only.
#
# There is NO fallback: on a disk store (sqlite/postgres) this key is REQUIRED
# whenever the certificate module is enabled. Without it nothing is issued --
# sealing is refused rather than writing a private key in plaintext -- and the
# portal shows the reason (the certificate view's module error names this
# variable, and the gateway logs it at WARN). No private key and no certificate
# material is stored either way; in ACME mode the pass additionally leaves a
# per-domain row with status=error (reason + backoff) in the certificate list,
# while self_signed aborts at the CA gate and writes only the note.
# Set it BEFORE switching cert_enabled on.
#
# Rotating it is supported and does not wedge the module: the old material stops
# being readable, so the gateway regenerates it -- a fresh ACME account in acme
# mode, a new internal CA in self_signed mode -- and logs both at WARN. In
# self_signed mode a new CA root means every client has to import the new bundle,
# so rotate deliberately there. Already-issued leaves stay `active` and are only
# re-issued at their normal renewal (self_signed additionally re-issues on the
# root's fingerprint change). See gateway/deploy/README-certificates.md.
OP_AI_GATEWAY_CERT_ENCRYPTION_KEY=

# Where the gateway writes the edge certificate for its own nginx (fullchain, key,
# CA root). Set this to a directory that BOTH the backend and the web (nginx)
# container mount -- then the gateway delivers the certificate itself and the key
# download endpoint refuses. Leave it EMPTY (or unset) when nginx runs somewhere
# the gateway cannot write to (e.g. Kubernetes): the portal then offers a
# one-time key download instead.
#
# The bundled docker-compose.yml/docker-compose.no-netbird.yml already wire this up
# for you: a shared named volume `certs` (backend: /shared/certs, matching this
# default; web/nginx: /etc/nginx/certs), and `web`'s ports now publish BOTH
# "8080:80" (unchanged) AND "8443:443" (the new TLS edge this certificate is for --
# a verifying upstream proxy should point at :8443, not :8080, once cert_edge_enabled
# is on). See gateway/deploy/README-certificates.md §6.
OP_AI_GATEWAY_CERT_EDGE_OUTPUT_DIR=/shared/certs

# Plaintext-refusal KILL SWITCH for the cert_edge_require_https portal setting
# (the switch that makes the gateway refuse unencrypted portal/API traffic once
# a fronting reverse proxy is confirmed to be terminating TLS on its behalf --
# see gateway/deploy/README-certificates.md). Set to 1/true/yes/on and the
# gateway NEVER refuses plaintext, no matter what cert_edge_require_https is
# stored as.
#
# This is deliberately an ENVIRONMENT VARIABLE, not a portal setting, and it
# OVERRIDES the stored setting: a misconfigured or prematurely-armed gate can
# make the portal itself unreachable over plaintext, and an operator locked
# out that way cannot open a UI they can no longer load to flip a stored
# setting back off. Restarting the container with this variable set is the
# recovery path for exactly that lockout, so it must be reachable even when
# the portal (and the settings store behind it) is not -- the gateway reads it
# once at startup, independent of any store lookup.
#
# Leave it EMPTY (or unset, the default) in normal operation -- that is "the
# kill switch is not engaged", not "plaintext is allowed" (cert_edge_require_https
# off already allows plaintext by itself).
OP_AI_GATEWAY_CERT_EDGE_REQUIRE_HTTPS_DISABLE=

# Emergency KILL SWITCH for P3's mesh plaintext-refusal gate
# (cert_mesh_require_tls). When set (1/true/yes/on) the mesh agent listener never
# refuses plaintext, regardless of the stored switch. This matters even more than
# the edge kill switch above: an armed mesh gate can lock out EVERY ServerAgent
# (no telemetry, servers drop out of routing), and the only way back is at the
# gateway -- this variable, read once at startup independent of the settings store.
# Leave EMPTY (the default) in normal operation.
OP_AI_GATEWAY_CERT_MESH_REQUIRE_TLS_DISABLE=

# host:port of the gateway's OWN edge (nginx) TLS listener for the synthetic
# self-probe -- an operator-triggered check that nginx really terminates TLS
# with a usable certificate, reporting WHY when it does not (unreachable,
# still the throwaway bootstrap certificate, a name mismatch, an untrusted
# chain, or expiry). The backend cannot reach that listener by itself in
# EITHER bundled topology -- in docker-compose the backend shares the NetBird
# sidecar's network namespace while `web` is its own service; in Kubernetes
# `op-gateway-web` is its own Deployment -- so leaving this EMPTY (the
# default) disables the probe endpoint (409), rather than guessing at an
# address. In the bundled docker-compose.yml/docker-compose.no-netbird.yml
# the value is the compose service name and TLS port: `web:443`.
OP_AI_GATEWAY_CERT_EDGE_PROBE_TARGET=web:443
